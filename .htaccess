# Kimberrys — Apache / LiteSpeed config for Hostinger
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: send www to the bare domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # Force HTTPS (skip local preview servers)
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost(?::\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Canonical menu URL: /menu serves menu.html
  RewriteCond %{THE_REQUEST} \s/+menu\.html[\s?] [NC]
  RewriteRule ^menu\.html$ /menu [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+menu/[\s?] [NC]
  RewriteRule ^menu/$ /menu [R=301,L,NE]
  RewriteRule ^menu/?$ menu.html [L]

  # Canonical privacy URL: /privacy serves privacy.html
  RewriteCond %{THE_REQUEST} \s/+privacy\.html[\s?] [NC]
  RewriteRule ^privacy\.html$ /privacy [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+privacy/[\s?] [NC]
  RewriteRule ^privacy/$ /privacy [R=301,L,NE]
  RewriteRule ^privacy/?$ privacy.html [L]

  # Canonical terms URL: /terms serves terms.html
  RewriteCond %{THE_REQUEST} \s/+terms\.html[\s?] [NC]
  RewriteRule ^terms\.html$ /terms [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+terms/[\s?] [NC]
  RewriteRule ^terms/$ /terms [R=301,L,NE]
  RewriteRule ^terms/?$ terms.html [L]

  # Canonical home URL
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]
</IfModule>

# Keep source files, working files and git metadata private if they are ever uploaded
RedirectMatch 404 ^/_source/
RedirectMatch 404 ^/\.(?!well-known(?:/|$))
RedirectMatch 404 ^/(?:ig-api\.json|ig-profile\.html|maps\.html|menu-raw\.pdf|qa\.js|README\.md)$
RedirectMatch 404 ^/(?:raw-|page-)[^/]+\.(?:jpe?g|png)$
RedirectMatch 404 ^/(?:qa|brand|source-photos)(?:/|$)

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
